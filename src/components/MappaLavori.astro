---
// Mappa dei lavori (Leaflet + OpenStreetMap). Si carica solo al click:
// così nessuna richiesta parte verso server esterni senza un'azione dell'utente.
import type { CollectionEntry } from 'astro:content';
import { SERVIZIO_LABEL } from '../lib/content';
import { t, type Locale } from '../i18n';

interface Props {
  lavori: CollectionEntry<'lavori'>[];
  locale?: Locale;
  height?: string;
}

const { lavori, locale = 'it', height = '26rem' } = Astro.props;
const points = lavori.map((lavoro) => ({
  titolo: lavoro.data.titolo,
  citta: lavoro.data.citta,
  lat: lavoro.data.lat,
  lng: lavoro.data.lng,
  servizio: lavoro.data.servizio,
  servizioLabel: SERVIZIO_LABEL[lavoro.data.servizio],
  href: `/lavori/${lavoro.id}`,
}));
---

<div class="mappa" data-mappa style={`--map-height:${height}`}>
  <script type="application/json" data-points set:html={JSON.stringify(points)} />
  <div class="mappa-canvas" data-canvas role="region" aria-label={t(locale, 'map.label')}>
    <div class="mappa-placeholder" data-placeholder>
      <svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true">
        <path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" />
      </svg>
      <p class="count">{points.length} {points.length === 1 ? 'lavoro' : 'lavori'}</p>
      <button type="button" class="btn btn-primary" data-load>{t(locale, 'map.load')}</button>
      <p class="notice">{t(locale, 'map.notice')}</p>
    </div>
  </div>
</div>

<script>
  import type { Map as LeafletMap } from 'leaflet';
  // Il CSS di Leaflet si carica solo quando l'utente apre la mappa
  import leafletCss from 'leaflet/dist/leaflet.css?url';

  function loadCss(href: string) {
    if (document.querySelector(`link[href="${href}"]`)) return;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = href;
    document.head.append(link);
  }

  interface Point {
    titolo: string;
    citta: string;
    lat: number;
    lng: number;
    servizio: string;
    servizioLabel: string;
    href: string;
  }

  function escapeHtml(value: string) {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  async function loadMap(root: HTMLElement) {
    const canvas = root.querySelector<HTMLElement>('[data-canvas]');
    const points = JSON.parse(root.querySelector('[data-points]')?.textContent ?? '[]') as Point[];
    if (!canvas) return;
    loadCss(leafletCss);
    const { default: L } = await import('leaflet');
    canvas.replaceChildren();
    const map: LeafletMap = L.map(canvas, { scrollWheelZoom: false }).setView([42.5, 12.5], 5);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);
    const markers = points.map((point) =>
      L.marker([point.lat, point.lng], {
        title: point.titolo,
        alt: point.titolo,
        icon: L.divIcon({ className: `pin pin-${point.servizio}`, iconSize: [22, 22], iconAnchor: [11, 22], popupAnchor: [0, -20] }),
      })
        .bindPopup(
          `<strong><a href="${point.href}">${escapeHtml(point.titolo)}</a></strong><br>${escapeHtml(point.citta)} · ${escapeHtml(point.servizioLabel)}`,
        )
        .addTo(map),
    );
    if (markers.length > 0) {
      map.fitBounds(L.featureGroup(markers).getBounds().pad(0.3), { maxZoom: 9 });
    }
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-mappa]')) {
    root.querySelector('[data-load]')?.addEventListener('click', () => void loadMap(root), { once: true });
  }
</script>

<style>
  .mappa-canvas {
    height: var(--map-height);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background:
      radial-gradient(circle at 30% 40%, color-mix(in srgb, var(--cold) 25%, transparent), transparent 55%),
      radial-gradient(circle at 70% 65%, color-mix(in srgb, var(--ember) 25%, transparent), transparent 55%),
      var(--surface);
    position: relative;
    z-index: 0;
  }

  .mappa-placeholder {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-2);
    text-align: center;
    padding: var(--space-4);
    color: var(--red);
  }

  .count {
    font-family: var(--serif);
    font-size: var(--fs-h3);
    color: var(--ink);
    margin: 0;
  }

  .notice {
    font-size: var(--fs-sm);
    color: var(--muted);
    margin: 0;
  }
</style>

<style is:global>
  .pin {
    width: 22px;
    height: 22px;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    border: 2px solid #fff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.35);
    background: var(--red);
  }

  .pin-conto-termico { background: #9e1b22; }
  .pin-detrazioni { background: #d9542b; }
  .pin-progettazione { background: #3d6e8c; }
  .pin-interior { background: #7a5a8c; }
  .pin-garden { background: #4f7a4a; }

  .leaflet-container {
    font: inherit;
  }

  .leaflet-popup-content a {
    color: #9e1b22;
  }
</style>
