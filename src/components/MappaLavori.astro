---
// Mappa dei lavori (Leaflet + OpenStreetMap). Si carica da sola quando arriva vicino allo schermo,
// così le pagine restano leggere finché la mappa non serve.
import type { CollectionEntry } from 'astro:content';
import { SERVIZIO_LABEL } from '../lib/content';
import { t, type Locale } from '../i18n';

interface Props {
  lavori: CollectionEntry<'lavori'>[];
  locale?: Locale;
  height?: string;
}

const { lavori, locale = 'it', height = '26rem' } = Astro.props;
const points = lavori.map((lavoro) => ({
  titolo: lavoro.data.titolo,
  citta: lavoro.data.citta,
  lat: lavoro.data.lat,
  lng: lavoro.data.lng,
  servizio: lavoro.data.servizio,
  servizioLabel: SERVIZIO_LABEL[lavoro.data.servizio],
  href: `/lavori/${lavoro.id}`,
}));
---

<div class="mappa" data-mappa style={`--map-height:${height}`}>
  <script type="application/json" data-points set:html={JSON.stringify(points)} />
  <div class="mappa-canvas" data-canvas role="region" aria-label={t(locale, 'map.label')}>
    <p class="mappa-placeholder">{points.length} {points.length === 1 ? 'lavoro' : 'lavori'}</p>
  </div>
</div>

<script>
  import type { Map as LeafletMap } from 'leaflet';
  // Il CSS di Leaflet si carica solo quando l'utente apre la mappa
  import leafletCss from 'leaflet/dist/leaflet.css?url';

  function loadCss(href: string) {
    if (document.querySelector(`link[href="${href}"]`)) return;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = href;
    document.head.append(link);
  }

  interface Point {
    titolo: string;
    citta: string;
    lat: number;
    lng: number;
    servizio: string;
    servizioLabel: string;
    href: string;
  }

  function escapeHtml(value: string) {
    const div = document.createElement('div');
    div.textContent = value;
    return div.innerHTML;
  }

  async function loadMap(root: HTMLElement) {
    const canvas = root.querySelector<HTMLElement>('[data-canvas]');
    const points = JSON.parse(root.querySelector('[data-points]')?.textContent ?? '[]') as Point[];
    if (!canvas) return;
    loadCss(leafletCss);
    const { default: L } = await import('leaflet');
    canvas.replaceChildren();
    const map: LeafletMap = L.map(canvas, { scrollWheelZoom: false }).setView([42.5, 12.5], 5);
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);
    const markers = points.map((point) =>
      L.marker([point.lat, point.lng], {
        title: point.titolo,
        alt: point.titolo,
        icon: L.divIcon({ className: `pin pin-${point.servizio}`, iconSize: [22, 22], iconAnchor: [11, 22], popupAnchor: [0, -20] }),
      })
        .bindPopup(
          `<strong><a href="${point.href}">${escapeHtml(point.titolo)}</a></strong><br>${escapeHtml(point.citta)} · ${escapeHtml(point.servizioLabel)}`,
        )
        .addTo(map),
    );
    if (markers.length > 0) {
      map.fitBounds(L.featureGroup(markers).getBounds().pad(0.3), { maxZoom: 9 });
    }
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        void loadMap(entry.target as HTMLElement);
      }
    },
    { rootMargin: '300px' },
  );
  for (const root of document.querySelectorAll<HTMLElement>('[data-mappa]')) observer.observe(root);
</script>

<style>
  .mappa-canvas {
    height: var(--map-height);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    background:
      radial-gradient(circle at 30% 40%, color-mix(in srgb, var(--cold) 25%, transparent), transparent 55%),
      radial-gradient(circle at 70% 65%, color-mix(in srgb, var(--ember) 25%, transparent), transparent 55%),
      var(--surface);
    position: relative;
    z-index: 0;
  }

  .mappa-placeholder {
    height: 100%;
    margin: 0;
    display: grid;
    place-content: center;
    font-family: var(--serif);
    font-size: var(--fs-h3);
    color: var(--muted);
  }
</style>

<style is:global>
  .pin {
    width: 22px;
    height: 22px;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    border: 2px solid #fff;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.35);
    background: var(--red);
  }

  .pin-conto-termico { background: #9e1b22; }
  .pin-detrazioni { background: #d9542b; }
  .pin-progettazione { background: #3d6e8c; }
  .pin-interior { background: #7a5a8c; }
  .pin-garden { background: #4f7a4a; }

  .leaflet-container {
    font: inherit;
  }

  .leaflet-popup-content a {
    color: #9e1b22;
  }
</style>
