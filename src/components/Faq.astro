---
import Testo from './Testo.astro';

interface Props {
  faq: { domanda: string; risposta: string }[];
  titolo?: string;
}

const { faq, titolo = 'Domande frequenti' } = Astro.props;
---

{
  faq.length > 0 && (
    <section class="faq section" aria-labelledby="faq-titolo">
      <div class="container narrow">
        <h2 id="faq-titolo">{titolo}</h2>
        {faq.map((item) => (
          <details>
            <summary>
              <Testo value={item.domanda} />
            </summary>
            <p>
              <Testo value={item.risposta} />
            </p>
          </details>
        ))}
      </div>
    </section>
  )
}

<style>
  details {
    border-bottom: 1px solid var(--line);
    padding: var(--space-3) 0;
  }

  summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 1.05rem;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    font-size: 1.5rem;
    color: var(--link);
    transition: transform 0.2s;
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }

  p {
    margin: var(--space-2) 0 0;
    color: var(--muted);
  }
</style>
