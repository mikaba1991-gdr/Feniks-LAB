---
import type { Crumb } from '../lib/seo';
import { t, type Locale } from '../i18n';

interface Props {
  crumbs: Crumb[];
  locale: Locale;
}

const { crumbs, locale } = Astro.props;
---

<nav class="breadcrumbs container" aria-label={t(locale, 'breadcrumb.label')}>
  <ol>
    {
      crumbs.map((crumb, index) => (
        <li>
          {index === crumbs.length - 1 ? (
            <span aria-current="page">{crumb.name}</span>
          ) : (
            <a href={crumb.href}>{crumb.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    padding-top: var(--space-4);
    font-size: var(--fs-sm);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    color: var(--muted);
  }

  li + li::before {
    content: '/';
    margin-right: var(--space-1);
    color: var(--line);
  }

  a {
    color: var(--muted);
  }
</style>
