---
// Fascia di invito all'azione verso il modulo guidato.
interface Props {
  href: string;
  titolo: string;
  testo: string;
  label?: string;
}

const { href, titolo, testo, label = 'Inizia la richiesta' } = Astro.props;
---

<section class="section">
  <div class="container">
    <div class="cta">
      <div>
        <h2>{titolo}</h2>
        <p>{testo}</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary" href={href}>{label}</a>
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-5);
    border-radius: var(--radius-xl);
    background: var(--warm);
    color: var(--ink);
  }

  h2 {
    margin-bottom: var(--space-2);
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-lg);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  .cta-actions :global(a:not(.btn)) {
    color: var(--warm-text);
    font-weight: 600;
  }

  @media (min-width: 60rem) {
    .cta {
      grid-template-columns: 1.5fr 1fr;
      align-items: center;
      padding: var(--space-7);
    }

    .cta-actions {
      justify-content: flex-end;
    }
  }
</style>
