---
import Testo from './Testo.astro';

interface Props {
  punti: { titolo: string; testo: string }[];
}

const { punti } = Astro.props;
---

{
  punti.length > 0 && (
    <section class="section punti">
      <div class="container">
        <ul class="punti-grid">
          {punti.map((punto) => (
            <li class="card">
              <h2 class="h3">
                <Testo value={punto.titolo} />
              </h2>
              <p>
                <Testo value={punto.testo} />
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .punti-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .h3 {
    font-size: var(--fs-h3);
  }

  p {
    margin: 0;
    color: var(--muted);
  }

  .punti {
    padding-top: 0;
  }
</style>
