---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ParlaConEsperto from '../components/ParlaConEsperto.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../config/site';
import { t, type Locale } from '../i18n';
import { breadcrumbJsonLd, serializeJsonLd, studioJsonLd, type Crumb } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  /** Immagine Open Graph (URL assoluto o relativo al sito) */
  image?: string;
  /** Percorso della stessa pagina nell'altra lingua (attiva hreflang e selettore lingua) */
  alternate?: { it: string; en: string };
  breadcrumbs?: Crumb[];
  jsonLd?: unknown[];
  noindex?: boolean;
  /** Mostra la barra "Parla con l'esperto" (di default sì) */
  expertCta?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  locale = 'it',
  image = '/og-default.png',
  alternate,
  breadcrumbs,
  jsonLd = [],
  noindex = false,
  expertCta = true,
  ogType = 'website',
} = Astro.props;

const siteUrl = new URL('/', Astro.site ?? Astro.url);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = Astro.url.pathname === '/' ? `${site.name} – ${site.tagline}` : `${title} | ${site.name}`;
const ogImage = new URL(image, siteUrl).href;
const altLangHref = alternate ? (locale === 'it' ? alternate.en : alternate.it) : undefined;

const structuredData = [
  ...(Astro.url.pathname === '/' ? [studioJsonLd(siteUrl)] : []),
  ...(breadcrumbs ? [breadcrumbJsonLd(breadcrumbs, siteUrl)] : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      alternate && (
        <>
          <link rel="alternate" hreflang="it" href={new URL(alternate.it, siteUrl).href} />
          <link rel="alternate" hreflang="en" href={new URL(alternate.en, siteUrl).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(alternate.it, siteUrl).href} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#F4E7E3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1C1717" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={locale === 'it' ? 'it_IT' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {structuredData.map((data) => <script type="application/ld+json" set:html={serializeJsonLd(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenuto">{t(locale, 'skipToContent')}</a>
    <Header locale={locale} altLangHref={altLangHref} />
    {breadcrumbs && <Breadcrumbs crumbs={breadcrumbs} locale={locale} />}
    <main id="contenuto" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    {expertCta && <ParlaConEsperto locale={locale} />}
  </body>
</html>
